# One source of agent instructions, compiled per profile and symlinked
# into every tool's global instruction path.
#
#   make build                      compile build/<profile>/AGENTS.md
#   make check                      fail if the build is stale
#   make deploy                     link it into ./fake-home (safe default)
#   make deploy TARGET_HOME=$HOME   link it into your real home
#   make PROFILE=work build         pick a profile (default: personal)

SHELL := /bin/bash
.PHONY: build check deploy clean

PROFILE     ?= personal
TARGET_HOME ?= $(CURDIR)/fake-home
OUT         := build/$(PROFILE)/AGENTS.md

# Every tool reads its global instructions from its own path.
LINKS := \
	.claude/CLAUDE.md \
	.agents/AGENTS.md \
	.codex/AGENTS.md \
	.pi/agent/AGENTS.md \
	.gemini/GEMINI.md \
	.config/opencode/AGENTS.md \
	.copilot/copilot-instructions.md

# Concatenate the profile's fragments, in order, with a source marker
# before each one. Fails on a fragment that does not exist.
define GENERATE
set -euo pipefail; \
printf '%s\n' '<!-- GENERATED by make build. Do not edit. Profile: $(PROFILE). -->'; \
while IFS= read -r name || [ -n "$$name" ]; do \
	case "$$name" in ''|'#'*) continue ;; esac; \
	if [ ! -f "fragments/$$name" ]; then \
		echo "ERROR: machines/$(PROFILE).txt lists $$name, but fragments/$$name does not exist" >&2; \
		exit 1; \
	fi; \
	printf '<!-- Source: fragments/%s -->\n' "$$name"; \
	cat "fragments/$$name"; \
	printf '\n'; \
done < machines/$(PROFILE).txt
endef

build:
	@mkdir -p build/$(PROFILE)
	@( $(GENERATE) ) > $(OUT).tmp || { rm -f $(OUT).tmp; exit 1; }
	@mv $(OUT).tmp $(OUT)
	@echo "built $(OUT)"

check:
	@set -euo pipefail; \
	tmp=$$(mktemp); trap 'rm -f "$$tmp"' EXIT; \
	( $(GENERATE) ) > "$$tmp"; \
	if [ ! -f "$(OUT)" ]; then \
		echo "check: $(OUT) is missing. Run: make build" >&2; exit 1; \
	fi; \
	if ! diff -u "$(OUT)" "$$tmp" >&2; then \
		echo "check: $(OUT) is out of date. Run: make build" >&2; exit 1; \
	fi; \
	echo "check: $(OUT) is up to date"

# Symlink the built file into every tool path under TARGET_HOME.
# A real file in the way is skipped with a warning, never overwritten.
deploy: build
	@set -euo pipefail; \
	src="$(CURDIR)/$(OUT)"; \
	for rel in $(LINKS); do \
		dest="$(TARGET_HOME)/$$rel"; \
		mkdir -p "$$(dirname "$$dest")"; \
		if [ -e "$$dest" ] && [ ! -L "$$dest" ]; then \
			echo "SKIP: $$dest is a real file. Back it up and remove it first." >&2; \
			continue; \
		fi; \
		ln -sfn "$$src" "$$dest"; \
		echo "linked $$dest"; \
	done

clean:
	@rm -rf build fake-home
	@echo "removed build/ and fake-home/"
